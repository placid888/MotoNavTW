<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- 頂部狀態列：藍牙與 GPS 狀態 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txtBleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔵 藍牙：未連線"
            android:textColor="#FF5722"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛰️ GPS：搜尋中"
            android:textColor="#FFEB3B"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 功能開關控制面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:padding="10dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <Switch
            android:id="@+id/switchGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="啟用 GPS"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Switch
            android:id="@+id/switchBle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="啟用 BLE"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 轉向導航提示區：大箭頭與距離 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#112211"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txtTurnIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="⬆️"
            android:textColor="#00E676"
            android:textSize="36sp"
            android:background="#223322" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/txtTurnDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="前方 150 公尺"
                android:textColor="#FFEB3B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTurnInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="準備向右轉"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 核心資訊：當前時速 (特大字體) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_weight="1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT SPEED"
            android:textColor="#888888"
            android:textSize="12sp"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/txtSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KM/H"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 底部導航指示：路名、音樂與媒體控制面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/txtRoadName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="等待導航路段..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 🎵 音樂同步顯示列 -->
        <TextView
            android:id="@+id/txtMediaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵 音樂：未播放"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <!-- 媒體控制按鈕列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⏮️ 上一首"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⏯️ 播放/暫停"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:backgroundTint="#00695C"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⏭️ 下一首"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtHexDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BLE Hex: 尚無數據"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>